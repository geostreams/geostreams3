meta {
  name: Post a category
  type: http
  seq: 8
}

post {
  url: {{base_url}}/geostreams/api/data/categories/
  body: json
  auth: apikey
}

auth:apikey {
  key: Authorization
  value: {{api_key}}
  placement: header
}

body:json {
  {
      "name": "Phosphorus",
      "detail_type": "time"
  }
}
