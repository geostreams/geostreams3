#Postgres configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=geostreams
POSTGRES_DB=postgres
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432

# Keycloak configuration
KEYCLOAK_CLIENT_ID=geostreams
KEYCLOAK_SERVER_URL=http://keycloak:8080/geostreams/keycloak/
KEYCLOAK_REALM=geostreams
KEYCLOAK_CLIENT_SECRET=

#Django configuration
# Set ALLOWED_HOSTS to your domain names in production, e.g. 'example.com,www.example.com'
ALLOWED_HOSTS=''

# Disable authentication for all methods, set to False for production
DISABLE_AUTH=False

SECRET_KEY=test
DEBUG=False

# API KEY expiration days
API_KEY_JWT_EXPIRY_DAYS=30
